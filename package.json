{
  "name": "grocery-list",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-sortables": "^1.10.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "rxdb": "^17.6.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "~26.6.6",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch --coverage=false",
    "typecheck": "tsc --noEmit",
    "test:e2e:web": "playwright test"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/src/app/",
          "\\.web-test\\.",
          "<rootDir>/e2e/"
        ],
        "moduleNameMapper": {
          "\\.css$": "<rootDir>/jest.style-mock.js"
        },
        "displayName": "ios",
        "preset": "jest-expo/ios",
        "resolver": "<rootDir>/jest.resolver.js",
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ]
      },
      {
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/src/app/",
          "\\.web-test\\.",
          "<rootDir>/e2e/"
        ],
        "moduleNameMapper": {
          "\\.css$": "<rootDir>/jest.style-mock.js"
        },
        "displayName": "android",
        "preset": "jest-expo/android",
        "resolver": "<rootDir>/jest.resolver.js",
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ]
      },
      {
        "displayName": "web",
        "preset": "jest-expo/web",
        "resolver": "<rootDir>/jest.resolver.js",
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.ts"
        ],
        "moduleNameMapper": {
          "\\.css$": "<rootDir>/jest.style-mock.js"
        },
        "testMatch": [
          "<rootDir>/src/__tests__/**/*.web-test.[jt]s?(x)"
        ],
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ],
        "setupFiles": [
          "<rootDir>/jest.setup.web.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/e2e/"
        ]
      }
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/test-utils/**",
      "!src/domain/types.ts",
      "!src/db/storage-config.ts",
      "!src/components/app-tabs.web.tsx"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  }
}
