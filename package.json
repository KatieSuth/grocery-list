{
  "name": "grocery-list",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "expo": "~57.0.32",
    "expo-constants": "~57.0.23",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.5",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-sortables": "^1.10.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1",
    "rxdb": "^17.6.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.17",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "test-renderer": "~1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch --coverage=false",
    "typecheck": "tsc --noEmit",
    "test:e2e:web": "playwright test"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/src/app/",
          "\\.web-test\\.",
          "<rootDir>/e2e/"
        ],
        "moduleNameMapper": {
          "\\.css$": "<rootDir>/jest.style-mock.js"
        },
        "displayName": "ios",
        "preset": "jest-expo/ios",
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|mingo))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ]
      },
      {
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/src/app/",
          "\\.web-test\\.",
          "<rootDir>/e2e/"
        ],
        "moduleNameMapper": {
          "\\.css$": "<rootDir>/jest.style-mock.js"
        },
        "displayName": "android",
        "preset": "jest-expo/android",
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|mingo))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ]
      },
      {
        "displayName": "web",
        "preset": "jest-expo/web",
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.ts"
        ],
        "moduleNameMapper": {
          "\\.css$": "<rootDir>/jest.style-mock.js"
        },
        "testMatch": [
          "<rootDir>/src/__tests__/**/*.web-test.[jt]s?(x)"
        ],
        "transformIgnorePatterns": [
          "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|mingo))",
          "/node_modules/react-native-reanimated/plugin/",
          "/node_modules/@react-native/babel-preset/"
        ],
        "setupFiles": [
          "<rootDir>/jest.setup.web.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/e2e/"
        ]
      }
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/test-utils/**",
      "!src/domain/types.ts",
      "!src/db/storage-config.ts",
      "!src/components/app-tabs.web.tsx"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  }
}
